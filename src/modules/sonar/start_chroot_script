# shellcheck enable=requires-variable-braces

# Error handling
set -Ee

# shellcheck disable=SC1091
source /common.sh
install_cleanup_trap

# --- Transient-network resilience -------------------------------------------
# Retry a command up to 5 times with a 10s backoff. NO silent failure: after the
# last attempt we return non-zero so set -e aborts the build (no "|| true").
retry() {
    local -i attempt=1 max_attempts=5 delay=10
    while true; do
        if "$@"; then
            return 0
        fi
        if (( attempt >= max_attempts )); then
            echo_red "Command failed after ${max_attempts} attempts: $*"
            return 1
        fi
        echo_yellow "Attempt ${attempt}/${max_attempts} failed, retrying in ${delay}s ..."
        sleep "${delay}"
        attempt+=1
    done
}

# Clone the sonar fork from scratch each attempt (a half-cloned dir would make
# a retry fail on "destination path already exists").
clone_sonar() {
    rm -rf "/home/${BASE_USER}/sonar"
    gitclone SONAR_REPO sonar
}

mkdir -p /tmp
chmod 1777 /tmp

# Module only Variables
SR_BUILD_PACKAGE_FILE="/tmp/sr_packages.lst"

echo_green "Installing sonar ..."

## Force apt update
retry apt-get update
## Make sure 'git' is installed!
retry check_install_pkgs git

## Step 1: Move to Home Dir as WorkingDirectoy
pushd "/home/${BASE_USER}" &> /dev/null || exit 1

## Step 2: clone sonar repo
echo_green "Clone sonar repository ..."
retry clone_sonar

## Step 3: Set SONAR_DEPS manually
echo_green "Manually defining SONAR_DEPS ..."
SONAR_DEPS="network-manager wireless-tools iw rfkill ethtool curl net-tools"

## Step 4: Install packages
echo_green "Install sonar dependencies ..."
# shellcheck disable=SC2086
retry check_install_pkgs ${SONAR_DEPS}

## Step 5: Move to sonar as working directory
pushd "/home/${BASE_USER}/sonar" &> /dev/null || exit 1

## Step 6: Run sonar install routine
## sonar's install.sh derives all paths from SONAR_DATA_PATH (MainsailOS convention).
## Without it, SONAR_SYSTEMD_PATH stays empty and "cp sonar.env ''" fails (Error 1, line 165).
## create_filestructure() only makes config/ and logs/, NOT systemd/ — so create it ourselves.
echo_green "Launch sonar install routine ..."
export SONAR_DATA_PATH="/home/${BASE_USER}/printer_data"
## Do NOT let upstream's installer add the update_manager entry: it hardcodes
## mainsail-crew/sonar.git as origin, which mismatches our fork clone and makes
## Moonraker invalidate the repo. We add the correct entry ourselves in Step 8b.
export SONAR_ADD_SONAR_MOONRAKER=0
mkdir -p "${SONAR_DATA_PATH}/systemd"
chown -R "${BASE_USER}:${BASE_USER}" "${SONAR_DATA_PATH}/systemd"
make install || { echo_red "Sonar install failed"; exit 1; }

## Step 7: Leave sonar
popd &> /dev/null || exit 1

## Step 8: Override sonar.conf — enable + tuned for NetworkManager
echo_green "Writing sonar.conf (enabled, 30s interval) ..."
cat <<'SONAREOF' > "/home/${BASE_USER}/printer_data/config/sonar.conf"
[sonar]
enable: true
debug_log: false
persistent_log: false
target: auto
count: 3
interval: 30
restart_threshold: 5
dongle_recovery: true
dongle_recovery_threshold: 3
tcp_fallback: true
tcp_check_host: 1.1.1.1
tcp_check_port: 443
SONAREOF
chown "${BASE_USER}:${BASE_USER}" "/home/${BASE_USER}/printer_data/config/sonar.conf"

## Step 8b: Point the update_manager entry at OUR fork so OTA works.
## We clone Yumi-Lab/sonar, but upstream's moonraker_update.txt hardcodes
## mainsail-crew/sonar.git as origin. Moonraker compares that origin to the
## repo's real remote, sees a mismatch, marks the repo invalid and shows
## neither the service nor an update in Mainsail. Repoint it (idempotent),
## and add the entry ourselves if it is missing entirely.
echo_green "Pointing sonar update_manager to Yumi-Lab fork ..."
MR_CONF="/home/${BASE_USER}/printer_data/config/moonraker.conf"
if [ -f "${MR_CONF}" ]; then
  if grep -q "mainsail-crew/sonar.git" "${MR_CONF}"; then
    sed -i 's#https://github.com/mainsail-crew/sonar.git#https://github.com/Yumi-Lab/sonar.git#g' "${MR_CONF}"
    echo_green "  origin repointed to Yumi-Lab/sonar."
  elif ! grep -q "\[update_manager sonar\]" "${MR_CONF}"; then
    cat <<'MREOF' >> "${MR_CONF}"

[update_manager sonar]
type: git_repo
path: ~/sonar
origin: https://github.com/Yumi-Lab/sonar.git
primary_branch: main
managed_services: sonar
MREOF
    chown "${BASE_USER}:${BASE_USER}" "${MR_CONF}"
    echo_green "  update_manager entry added (Yumi-Lab/sonar)."
  else
    echo_green "  update_manager entry already correct."
  fi
else
  echo_red "  moonraker.conf not found — update_manager entry skipped."
fi

## Step 9: NetworkManager WiFi auto-reconnect dispatcher
echo_green "Installing NetworkManager WiFi reconnect dispatcher ..."
cat <<'DISPEOF' > /etc/NetworkManager/dispatcher.d/99-wifi-reconnect
#!/usr/bin/env bash
# Reconnect WiFi automatically when connection drops
# Triggered by NetworkManager on interface state changes

IFACE="$1"
ACTION="$2"

# Only act on WiFi interfaces going down
# wlan*/wlp* = onboard, wlx* = USB dongles (named after MAC, e.g. wlx40a5ef1307ee)
case "$IFACE" in wlan*|wlp*|wlx*) ;; *) exit 0 ;; esac

if [ "$ACTION" = "down" ]; then
    logger -t wifi-reconnect "WiFi $IFACE went down, scheduling reconnect ..."
    # Wait a bit then ask NM to re-activate
    (
        sleep 5
        # Unblock the radio first — a soft-blocked / wedged dongle can no
        # longer scan, so a plain "device connect" silently does nothing.
        rfkill unblock wifi 2>/dev/null
        nmcli radio wifi on 2>/dev/null
        nmcli device set "$IFACE" managed yes 2>/dev/null
        sleep 2
        nmcli device connect "$IFACE" 2>/dev/null \
            || { nmcli networking off; sleep 2; nmcli networking on; }
        logger -t wifi-reconnect "WiFi reconnect attempt done for $IFACE"
    ) &
fi
DISPEOF
chmod 755 /etc/NetworkManager/dispatcher.d/99-wifi-reconnect

## Step 10: Force autoconnect on all future WiFi connections
echo_green "Configuring NetworkManager autoconnect ..."
cat <<'NMEOF' > /etc/NetworkManager/conf.d/wifi-autoconnect.conf
[connection]
# Retry WiFi connection indefinitely (0 = infinite retries)
connection.autoconnect-retries=0
NMEOF

## Step 11: clean packages.lst file
rm -f "${SR_BUILD_PACKAGE_FILE}"

## Step 12: leave home dir
popd &> /dev/null || exit 1

## Step 13: Enable sonar service
echo_green "Enable sonar.service ..."
systemctl_if_exists enable sonar.service

## Finish
echo_green "Installing sonar ... DONE!"
