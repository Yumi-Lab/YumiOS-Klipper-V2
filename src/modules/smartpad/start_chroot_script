#!/usr/bin/env bash
#### SmartPad / SmartPi ONE — Yumi-specific tweaks
####
#### This module handles all Yumi-Lab customizations:
#### - Plymouth boot theme
#### - YUMI_SYNC
#### - moonraker-yumi-lab plugin
#### - yumi-config install.sh
#### - YUMI_PLR (power loss recovery)
#### - Webcam fix service
#### - Moonraker allowed services
#### - Firstboot wizard (only on boards with display): rotation, MCU build, KlipperScreen
####
#### Works for both SmartPad (arm64, display) and SmartPi ONE (armhf, headless)

# shellcheck enable=require-variable-braces
set -Ee

# shellcheck disable=SC1091
source /common.sh
install_cleanup_trap

### Helper func
is_board_type() {
    local board releasefile
    board=""
    releasefile="/etc/armbian-release"
    if [[ -f "${releasefile}" ]]; then
        board="$(grep "BOARD=" "${releasefile}" | cut -d'=' -f2)"
    fi
    echo "${board}"
}

has_display() {
    # SmartPad and SmartPi ONE are the same hardware.
    # SmartPad = with display, SmartPi ONE = headless.
    # Since we can't detect display at build time (chroot), always enable
    # the firstboot wizard — it will detect display at runtime.
    echo "1"
}

echo_green "Apply Yumi-Lab specific patches..."

## Step 0: Install dependencies
# shellcheck disable=SC2086
check_install_pkgs ${SMARTPAD_DEPS}

## Step 1: Unpack filesystem overlay
unpack /filesystem/root /

## Step 2: Enable SPI + UART (same hardware: SmartPad and SmartPi ONE both use H3)
echo_green "Enable Serial and SPI interface..."
# Remove any existing overlays/param_spidev lines to avoid duplicates (u-boot reads first occurrence only)
sed -i '/^overlays=/d' "${SMARTPAD_CONFIG_TXT_FILE}"
sed -i '/^param_spidev_spi_bus=/d' "${SMARTPAD_CONFIG_TXT_FILE}"
echo "overlays=spi-spidev uart1 uart2" >> "${SMARTPAD_CONFIG_TXT_FILE}"
echo "param_spidev_spi_bus=1" >> "${SMARTPAD_CONFIG_TXT_FILE}"
echo_green "Enable Serial and SPI interface... DONE!"

## Step 2b: Disable USB autosuspend + enable plymouth splash in kernel args
echo_green "Configure kernel extra args (USB autosuspend + splash)..."
if grep -q "^extraargs=" "${SMARTPAD_CONFIG_TXT_FILE}"; then
    sed -i 's/^extraargs=\(.*\)/extraargs=\1 usbcore.autosuspend=-1 splash/' "${SMARTPAD_CONFIG_TXT_FILE}"
else
    echo "extraargs=usbcore.autosuspend=-1 splash" >> "${SMARTPAD_CONFIG_TXT_FILE}"
fi
echo_green "Configure kernel extra args... DONE!"

## Step 3: Plymouth boot theme — installed AND embedded in the initramfs at build time
##
## `update-initramfs -u` without a version is a silent no-op inside the build chroot:
## the Armbian/DietPi bases ship no /var/lib/initramfs-tools record and `uname -r`
## is the CI runner kernel, so update-initramfs finds "nothing to do" and exits 0.
## Images built until 2026-06 therefore shipped the untouched base initrd and let the
## firstboot wizard regenerate it on the pad — and that on-device regeneration is the
## step that produced un-bootable pads (kernel panic "Attempted to kill init!
## exitcode=0x00007f00" = the initramfs could not exec run-init after init-bottom).
## Generating the initramfs here for the kernel actually installed in the image, and
## verifying its content, makes the image boot with the Yumi splash from the very
## first power-on, with nothing left to rebuild on the device.
echo_green "Install Yumi Lab Plymouth theme..."
pushd "/home/${BASE_USER}" &>/dev/null || exit 1

install_plymouth_theme() {
    local src dest theme_name
    dest="/usr/share/plymouth/themes/"
    src="/home/${BASE_USER}/$(basename "${SMARTPAD_PLYMOUTH_REPO/.git/}")"
    src="${src}/${SMARTPAD_PLYMOUTH_THEME}"
    theme_name="$(basename "${SMARTPAD_PLYMOUTH_THEME}")"
    if [[ ! -d "${src}" ]]; then
        echo_red "Plymouth theme ${SMARTPAD_PLYMOUTH_THEME} not found in ${SMARTPAD_PLYMOUTH_REPO}"
        return 1
    fi
    cp -r "${src}" "${dest}"
    plymouth-set-default-theme "${theme_name}"
    echo_green "Plymouth theme set to ${theme_name}"
}

# Exactly one kernel is installed in the base images; refuse to guess otherwise.
image_kernel_version() {
    local -a versions
    mapfile -t versions < <(ls -1 /lib/modules)
    if [[ "${#versions[@]}" -ne 1 ]]; then
        echo_red "Expected exactly one kernel in /lib/modules, found: ${versions[*]:-none}"
        return 1
    fi
    echo "${versions[0]}"
}

# The initramfs must contain what the boot chain needs, and /boot/uInitrd must be
# the U-Boot wrap of THIS initrd (post-update hook, with the FAT mv fallback).
verify_initramfs() {
    local initrd="$1" theme_name="$2" listing klibc_so entry initrd_size uinitrd_size
    listing="$(lsinitramfs "${initrd}")"
    # run-init is a klibc binary: the loader it names must be inside, hash included
    klibc_so="$(grep -ao 'klibc-[A-Za-z0-9_-]*\.so' /usr/lib/klibc/bin/run-init | head -n1)"
    if [[ -z "${klibc_so}" ]]; then
        echo_red "Cannot read the klibc loader name from /usr/lib/klibc/bin/run-init"
        return 1
    fi
    for entry in \
        "^usr/bin/run-init$" \
        "^usr/lib/${klibc_so}$" \
        "^usr/share/plymouth/themes/${theme_name}/${theme_name}\.plymouth$" \
        "^usr/lib/[^/]+/plymouth/two-step\.so$"; do
        if ! grep -Eq "${entry}" <<< "${listing}"; then
            echo_red "initramfs ${initrd} lacks ${entry}"
            return 1
        fi
    done
    initrd_size="$(stat -c %s "${initrd}")"
    uinitrd_size="$(mkimage -l /boot/uInitrd | awk '/Data Size/ {print $3}')"
    if [[ "${initrd_size}" != "${uinitrd_size}" ]]; then
        echo_red "/boot/uInitrd (${uinitrd_size} B) does not wrap ${initrd} (${initrd_size} B)"
        return 1
    fi
    echo_green "initramfs verified: run-init, ${klibc_so}, theme ${theme_name}, uInitrd in sync"
}

build_initramfs() {
    local kver theme_name initrd
    kver="$(image_kernel_version)"
    theme_name="$(basename "${SMARTPAD_PLYMOUTH_THEME}")"
    initrd="/boot/initrd.img-${kver}"
    if [[ ! -f "${initrd}" ]]; then
        echo_red "${initrd} missing in the base image"
        return 1
    fi
    echo_green "Generating ${initrd} (kernel ${kver}) with the ${theme_name} theme..."
    # -k: never rely on the version lookup, it does not see the image kernel in a chroot
    update-initramfs -u -k "${kver}"
    verify_initramfs "${initrd}" "${theme_name}"
}

sudo -u "${BASE_USER}" git clone "${SMARTPAD_PLYMOUTH_REPO}"
install_plymouth_theme
build_initramfs
popd &>/dev/null || exit 1
echo_green "Install Yumi Lab Plymouth theme... [DONE]"

## Step 3b: splash from the first boot — the theme is embedded now (this used to be
## flipped by the wizard, after its on-device initramfs rebuild)
echo_green "Enable Plymouth boot logo..."
sed -i '/^bootlogo=/d' "${SMARTPAD_CONFIG_TXT_FILE}"
echo "bootlogo=true" >> "${SMARTPAD_CONFIG_TXT_FILE}"
echo_green "Enable Plymouth boot logo... [DONE]"

## Step 4: YUMI_SYNC
echo_green "Install YUMI_SYNC ..."
pushd "/home/${BASE_USER}" &>/dev/null || exit 1
sudo -u "${BASE_USER}" git clone https://github.com/Yumi-Lab/YUMI_SYNC.git
pushd YUMI_SYNC &>/dev/null || exit 1
git config --global --add safe.directory "/home/${BASE_USER}/YUMI_SYNC"
make install
git checkout . 2>/dev/null
popd &>/dev/null || exit 1
popd &>/dev/null || exit 1
chown -R "${BASE_USER}:${BASE_USER}" "/home/${BASE_USER}/YUMI_SYNC"
echo_green "Install YUMI_SYNC ... [DONE]"

## Step 5: moonraker-app-yumi-lab plugin
echo_green "Install moonraker-app-yumi-lab ..."
pushd "/home/${BASE_USER}" &>/dev/null || exit 1
unpack /filesystem/home/"${BASE_USER}" /home/"${BASE_USER}" "${BASE_USER}"
sudo -u "${BASE_USER}" git clone https://github.com/Yumi-Lab/moonraker-app-yumi-lab.git
pushd moonraker-app-yumi-lab &>/dev/null || exit 1
chmod +x ./install.sh
sudo -u "${BASE_USER}" ./install.sh \
    -C "/home/${BASE_USER}/printer_data/config/moonraker.conf" \
    -p 7125 -H 127.0.0.1 \
    -l "/home/${BASE_USER}/printer_data/logs" \
    -L -S "https://app.yumi-lab.com"
popd &>/dev/null || exit 1
popd &>/dev/null || exit 1
# moonraker-yumi-update.cfg is created by install.sh
echo_green "Install moonraker-app-yumi-lab ... [DONE]"

## Step 6: yumi-config install script
echo_green "Install yumi-config ..."
pushd "/home/${BASE_USER}" &>/dev/null || exit 1
# yumi-config is already cloned by the yumios module
if [[ -d "/home/${BASE_USER}/yumi-config" ]]; then
    pushd yumi-config &>/dev/null || exit 1
    chmod +x ./install.sh
    ./install.sh
    popd &>/dev/null || exit 1
else
    echo_green "yumi-config not found, skipping install.sh"
fi
popd &>/dev/null || exit 1
echo_green "Install yumi-config ... [DONE]"

## Step 7: YUMI_PLR (Power Loss Recovery)
echo_green "Install YUMI_PLR ..."
pushd "/home/${BASE_USER}" &>/dev/null || exit 1
# Repo renomme Yumi_PLR ; on force le dossier local YUMI_PLR (chemins en dur dans plr.cfg)
sudo -u "${BASE_USER}" git clone https://github.com/Yumi-Lab/Yumi_PLR.git YUMI_PLR
pushd YUMI_PLR &>/dev/null || exit 1
chmod +x ./install.sh
./install.sh
popd &>/dev/null || exit 1
popd &>/dev/null || exit 1
echo_green "Install YUMI_PLR ... [DONE]"

## Step 8: Fix printer_data permissions
chmod 775 -R "/home/${BASE_USER}/printer_data/"
chown -R "${BASE_USER}:${BASE_USER}" "/home/${BASE_USER}/printer_data/"

## Step 9: Webcam fix service
echo_green "Install fix-webcam service ..."

SCRIPT_PATH="/usr/local/bin/fix-webcam.sh"
SERVICE_PATH="/etc/systemd/system/fix-webcam.service"

cat << 'WEBCAM_SCRIPT' > "${SCRIPT_PATH}"
#!/bin/bash
sleep 3
[ -L /dev/webcam ] && rm -f /dev/webcam
for dev in /dev/video*; do
    if v4l2-ctl --device="$dev" --all &>/dev/null; then
        ln -s "$dev" /dev/webcam
        exit 0
    fi
done
exit 1
WEBCAM_SCRIPT
chmod +x "${SCRIPT_PATH}"

cat << 'WEBCAM_SERVICE' > "${SERVICE_PATH}"
[Unit]
Description=Fix Webcam Symlink
After=multi-user.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/fix-webcam.sh
RemainAfterExit=true

[Install]
WantedBy=multi-user.target
WEBCAM_SERVICE

systemctl_if_exists enable fix-webcam.service
echo_green "Install fix-webcam service ... [DONE]"

## Step 10: Moonraker allowed services
echo_green "Configure moonraker allowed services ..."
FILE="/home/${BASE_USER}/printer_data/moonraker.asvc"
SERVICES=("KlipperScreen" "yumi_sync" "crowsnest" "moonraker-app-yumi-lab" "sonar")

for SERVICE in "${SERVICES[@]}"; do
    grep -qxF "${SERVICE}" "${FILE}" 2>/dev/null || echo "${SERVICE}" >> "${FILE}"
done
echo_green "Configure moonraker allowed services ... [DONE]"

## Step 11: Firstboot wizard (only on display boards)
if [[ "$(has_display)" == "1" ]]; then
    echo_green "Setup firstboot wizard (display detected)..."
    systemctl_if_exists disable KlipperScreen.service
    chmod +x /usr/local/bin/firstboot
    systemctl_if_exists enable firstboot.service
    echo_green "Setup firstboot wizard ... [DONE]"
else
    echo_green "Headless board — skipping firstboot wizard, enabling KlipperScreen directly"
    # On headless boards, KlipperScreen stays enabled (VNC/remote access)
    # No firstboot wizard needed
    rm -f /usr/local/bin/firstboot
    rm -f /etc/systemd/system/firstboot.service
    rm -f /.firstboot
fi

echo_green "Apply Yumi-Lab specific patches... [ALL DONE]"
